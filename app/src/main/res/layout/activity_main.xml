<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    tools:context=".ui.main.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- App Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/welcome_title"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Start Scanning Button (HUGE) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/primary_yellow"
            android:contentDescription="@string/cd_start_scan"
            android:fontFamily="sans-serif-medium"
            android:text="@string/start_scanning"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:elevation="8dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="32dp"
            app:iconTint="@color/text_on_primary"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Dose Tracker Section (Bugünkü İlaçlarım) -->
        <TextView
            android:id="@+id/tvDoseTrackerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/today_doses"
            android:textColor="@color/primary_yellow"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnStart" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDoseTracker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvDoseTrackerTitle"
            tools:itemCount="2"
            tools:listitem="@layout/item_dose_tracker" />

        <TextView
            android:id="@+id/tvNoDoses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Bugün alınacak ilaç bulunmuyor."
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvDoseTrackerTitle" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierDose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="rvDoseTracker,tvNoDoses" />

        <!-- History Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/cd_scan_history"
            android:text="@string/scan_history"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/text_primary"
            app:layout_constraintTop_toBottomOf="@id/barrierDose"
            app:strokeColor="@color/primary_yellow"
            app:strokeWidth="3dp" />

        <!-- Help Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/cd_help"
            android:text="@string/how_it_works"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_help"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/text_primary"
            app:layout_constraintTop_toBottomOf="@id/btnHistory"
            app:strokeColor="@color/primary_yellow"
            app:strokeWidth="3dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
